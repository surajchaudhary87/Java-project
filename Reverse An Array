// Reverse Array Program 
public class Main {
  
  static void reverse_Arr(int arr[]) {
      int size = arr.length;
      int i = 0;
      int j = size-1;
      
      while (i <= j) {
      // reverse 
      int temp = arr[i];
      arr[i] = arr[j];
      arr[j] = temp;
      // i++
      i++;
      // j--
      j--;       
     }
    
    System.out.println("Reversed array :");
    for(int k: arr){
      System.out.print(k + " ");
    }
  
  }
  
  public static void main(String args []) {
    int array[] = {1,2,3,4,5};
    reverse_Arr(array);
  }

}
